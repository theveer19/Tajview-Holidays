# Tajview Holidays — Apache configuration
# Upload this file to public_html alongside index.html.

RewriteEngine On

# ---- Pretty URLs -------------------------------------------------------
# /tours/taj-mahal-day-tour-from-delhi  ->  tour.html?tour=...
RewriteRule ^tours/([a-z0-9-]+)/?$ tour.html?tour=$1 [L,QSA]
# /journal/best-time-to-visit-taj-mahal  ->  blog-post.html?post=...
RewriteRule ^journal/([a-z0-9-]+)/?$ blog-post.html?post=$1 [L,QSA]
# /about  ->  about.html  (works for every page, no .html needed)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)/?$ $1.html [L]

# ---- Redirects from the old WordPress URLs -----------------------------
Redirect 301 /taj-mahal-tour-packages/ /taj-mahal-tour-packages.html
Redirect 301 /new-delhi-tour-packages/ /new-delhi-tour-packages.html
Redirect 301 /same-day-tour-packages/ /same-day-tour-packages.html
Redirect 301 /jaipur-tour-packages/ /jaipur-tour-packages.html
Redirect 301 /golden-triangle-tour-packages/ /golden-triangle-tour-packages.html
Redirect 301 /rajasthan-tour-packages/ /rajasthan-tour-packages.html
Redirect 301 /agra-tours/ /agra-tours.html
Redirect 301 /delhi-tours/ /delhi-tours.html
Redirect 301 /jaipur-tours/ /jaipur-tours.html
Redirect 301 /jodhpur-tours/ /jodhpur-tours.html
Redirect 301 /udaipur-tours/ /udaipur-tours.html
Redirect 301 /jaisalmer-tours/ /jaisalmer-tours.html
Redirect 301 /ranthambore-tours/ /ranthambore-tours.html
Redirect 301 /about-us/ /about.html
Redirect 301 /contact-us/ /contact.html
Redirect 301 /plan-my-tour/ /contact.html
