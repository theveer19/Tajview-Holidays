# Tajview Holidays — Apache configuration
# Upload this file to public_html alongside index.html.

RewriteEngine On

# ---- Pretty URLs -------------------------------------------------------
# Every tour and article is a real file: /tours/<slug>.html, /journal/<slug>.html
# (built by tools/build.js). Old ?tour= / ?post= links are forwarded by the page itself.
# /about  ->  about.html, /tours/x -> tours/x.html  (no .html needed)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)/?$ $1.html [L]

# ---- Redirects from the old WordPress URLs -----------------------------
Redirect 301 /taj-mahal-tour-packages/ /taj-mahal-tour-packages.html
Redirect 301 /new-delhi-tour-packages/ /new-delhi-tour-packages.html
Redirect 301 /same-day-tour-packages/ /same-day-tour-packages.html
